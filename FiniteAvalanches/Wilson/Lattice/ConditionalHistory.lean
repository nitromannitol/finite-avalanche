import FiniteAvalanches.Wilson.Lattice.BatchRestart
import FiniteAvalanches.Probability.Survival
import Mathlib.Probability.Independence.InfinitePi
import Mathlib.Probability.ConditionalExpectation
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Indicator
import Mathlib.Topology.Bases

set_option autoImplicit false
namespace FiniteAvalanches.Wilson.Lattice.ConditionalIteration7
open LatticeProb MeasureTheory ProbabilityTheory Filter BatchRestart
open scoped Classical
noncomputable section

abbrev Rows := ℕ → WalkDriver

abbrev rowSigma (i : ℕ) : MeasurableSpace Rows :=
  (inferInstance : MeasurableSpace WalkDriver).comap (fun ξ => ξ i)

abbrev consumedRows (n : ℕ) : MeasurableSpace Rows := ⨆ i ∈ {i : ℕ | i < n}, rowSigma i

abbrev freshRows (n : ℕ) : MeasurableSpace Rows := ⨆ i ∈ {i : ℕ | n ≤ i}, rowSigma i

/-- The atom specifies the entire actual output, including every stopped walk. -/
def historyAtom (R : RootPair) (L : List (Site 2)) (out : SamplerState) : Set Rows :=
  {ξ | samplerRun (initialSampler R) L ξ = some out}

/-- Exactly the sigma-algebra generated by the actual completed-history atoms. -/
abbrev fullHistory (R : RootPair) (L : List (Site 2)) : MeasurableSpace Rows :=
  MeasurableSpace.generateFrom (Set.range (historyAtom R L))

/-- Literal successful continuation and finite joint color observation. -/
def continuationPattern (st : SamplerState) (Q : List (Site 2))
    (D : Finset (Site 2)) (pc : Site 2 → Bool) : Set Rows :=
  {η | ∃ next, samplerRun st Q η = some next ∧ ∀ d ∈ D, next.colors d = some (pc d)}

theorem rowSigma_le (i : ℕ) : rowSigma i ≤ (inferInstance : MeasurableSpace Rows) :=
  (measurable_pi_apply i).comap_le

theorem consumedRows_le (n : ℕ) : consumedRows n ≤ (inferInstance : MeasurableSpace Rows) :=
  iSup_le (fun i => iSup_le (fun _ => rowSigma_le i))

theorem freshRows_le (n : ℕ) : freshRows n ≤ (inferInstance : MeasurableSpace Rows) :=
  iSup_le (fun i => iSup_le (fun _ => rowSigma_le i))

theorem samplerRun_eq_of_prefix (st : SamplerState) (L : List (Site 2)) (ξ η : Rows)
    (h : ∀ i < L.length, ξ i = η i) : samplerRun st L ξ = samplerRun st L η := by
  induction L generalizing st ξ η with
  | nil => rfl
  | cons x xs ih =>
    have h0 : ξ 0 = η 0 := h 0 (by simp)
    simp only [samplerRun, h0]
    congr 1
    funext next
    exact ih next (fun i => ξ (i + 1)) (fun i => η (i + 1))
      (fun i hi => h (i + 1) (by simpa using Nat.add_lt_add_right hi 1))

theorem isOpen_successFiber (st out : SamplerState) (L : List (Site 2)) :
    IsOpen {ξ : Rows | samplerRun st L ξ = some out} := by
  apply isOpen_iff_mem_nhds.mpr
  intro ξ hξ
  exact samplerRun_eventually_eq_of_some st out L ξ hξ

theorem measurable_historyAtom_consumed (R : RootPair) (L : List (Site 2))
    (out : SamplerState) : MeasurableSet[consumedRows L.length] (historyAtom R L out) := by
  by_cases hex : (historyAtom R L out).Nonempty
  · obtain ⟨ξ₀, hξ₀⟩ := hex
    let extend : (Fin L.length → WalkDriver) → Rows :=
      fun z i => if hi : i < L.length then z ⟨i, hi⟩ else ξ₀ i
    have hext : Continuous extend := continuous_pi (fun i => by
      dsimp [extend]
      split_ifs with hi
      · exact continuous_apply (⟨i, hi⟩ : Fin L.length)
      · exact continuous_const)
    have hp : @Measurable Rows (Fin L.length → WalkDriver) (consumedRows L.length)
        inferInstance (fun ξ i => ξ i.val) := by
      letI : MeasurableSpace Rows := consumedRows L.length
      apply measurable_pi_lambda
      intro i
      apply Measurable.of_comap_le
      exact le_iSup_of_le i.val (le_iSup_of_le i.isLt le_rfl)
    have hf := ((isOpen_successFiber (initialSampler R) out L).preimage hext).measurableSet
    have he : historyAtom R L out =
        (fun ξ : Rows => fun i : Fin L.length => ξ i.val) ⁻¹'
          (extend ⁻¹' {ξ : Rows | samplerRun (initialSampler R) L ξ = some out}) := by
      ext ξ
      change (samplerRun (initialSampler R) L ξ = some out) ↔
        (samplerRun (initialSampler R) L (extend (fun i => ξ i.val)) = some out)
      rw [samplerRun_eq_of_prefix (initialSampler R) L ξ (extend (fun i => ξ i.val))
        (fun i hi => by simp [extend, hi])]
    rw [he]
    letI : MeasurableSpace Rows := consumedRows L.length
    exact hf.preimage hp
  · have he : historyAtom R L out = ∅ := Set.not_nonempty_iff_eq_empty.mp hex
    rw [he]
    exact @MeasurableSet.empty Rows (consumedRows L.length)

theorem fullHistory_le_consumed (R : RootPair) (L : List (Site 2)) :
    fullHistory R L ≤ consumedRows L.length := by
  apply MeasurableSpace.generateFrom_le
  rintro _ ⟨out, rfl⟩
  exact measurable_historyAtom_consumed R L out

theorem fullHistory_le (R : RootPair) (L : List (Site 2)) :
    fullHistory R L ≤ (inferInstance : MeasurableSpace Rows) :=
  (fullHistory_le_consumed R L).trans (consumedRows_le L.length)

theorem measurable_historyAtom (R : RootPair) (L : List (Site 2)) (out : SamplerState) :
    MeasurableSet[fullHistory R L] (historyAtom R L out) :=
  MeasurableSpace.measurableSet_generateFrom ⟨out, rfl⟩


/-- The consumed-row filtration is increasing; no independence is supplied as an input. -/
theorem consumedRows_mono : Monotone consumedRows := by
  intro n m hnm
  apply iSup_le
  intro i
  apply iSup_le
  intro hi
  exact le_iSup_of_le i (le_iSup_of_le (Nat.lt_of_lt_of_le hi hnm) le_rfl)

/-- The complete successful states have countable support, because their full
stopped-history fibers are disjoint nonempty open sets in the real row space. -/
theorem reachable_states_countable (R : RootPair) (L : List (Site 2)) :
    {out : SamplerState | (historyAtom R L out).Nonempty}.Countable := by
  have hd : {out : SamplerState | (historyAtom R L out).Nonempty}.PairwiseDisjoint
      (historyAtom R L) := by
    intro out _ out' _ hne
    apply Set.disjoint_left.mpr
    intro ξ hx hy
    exact hne (Option.some.inj (hx.symm.trans hy))
  exact hd.countable_of_isOpen (fun out _ => isOpen_successFiber (initialSampler R) out L)
    (fun _ h => h)

/-- Every predicate of the complete successful output is history-measurable,
not only individual atoms or single-vertex observations. -/
theorem measurable_completed_observation (R : RootPair) (L : List (Site 2))
    (P : SamplerState → Prop) : MeasurableSet[fullHistory R L]
      {ξ : Rows | ∃ out, samplerRun (initialSampler R) L ξ = some out ∧ P out} := by
  let A := {out : SamplerState | (historyAtom R L out).Nonempty ∧ P out}
  have hA : A.Countable := (reachable_states_countable R L).mono (fun _ h => h.1)
  have he : {ξ : Rows | ∃ out, samplerRun (initialSampler R) L ξ = some out ∧ P out} =
      ⋃ out ∈ A, historyAtom R L out := by
    ext ξ
    simp only [Set.mem_setOf_eq, Set.mem_iUnion]
    constructor
    · rintro ⟨out, hs, hp⟩
      exact ⟨out, ⟨⟨ξ, hs⟩, hp⟩, hs⟩
    · rintro ⟨out, ha, hs⟩
      exact ⟨out, hs, ha.2⟩
  rw [he]
  letI : MeasurableSpace Rows := fullHistory R L
  exact MeasurableSet.biUnion hA (fun out _ => measurable_historyAtom R L out)

/-- The sigma-algebra really observes the entire Option-valued run, including
failure, rather than silently discarding unsuccessful histories. -/
theorem measurable_full_output (R : RootPair) (L : List (Site 2)) :
    @Measurable Rows (Option SamplerState) (fullHistory R L) ⊤
      (samplerRun (initialSampler R) L) := by
  intro A _
  have hS := measurable_completed_observation R L (fun out => some out ∈ A)
  have hsuccess := measurable_completed_observation R L (fun _ => True)
  have hnone : MeasurableSet[fullHistory R L]
      {ξ : Rows | samplerRun (initialSampler R) L ξ = none} := by
    have he : {ξ : Rows | samplerRun (initialSampler R) L ξ = none} =
        {ξ : Rows | ∃ out, samplerRun (initialSampler R) L ξ = some out ∧ True}ᶜ := by
      ext ξ
      cases hs : samplerRun (initialSampler R) L ξ <;> simp [hs]
    rw [he]
    exact hsuccess.compl
  by_cases hn : none ∈ A
  · have he : (samplerRun (initialSampler R) L) ⁻¹' A =
        {ξ : Rows | samplerRun (initialSampler R) L ξ = none} ∪
          {ξ : Rows | ∃ out, samplerRun (initialSampler R) L ξ = some out ∧ some out ∈ A} := by
      ext ξ
      cases hs : samplerRun (initialSampler R) L ξ <;> simp [hs, hn]
    rw [he]
    exact @MeasurableSet.union Rows (fullHistory R L) _ _ hnone hS
  · have he : (samplerRun (initialSampler R) L) ⁻¹' A =
        {ξ : Rows | ∃ out, samplerRun (initialSampler R) L ξ = some out ∧ some out ∈ A} := by
      ext ξ
      cases hs : samplerRun (initialSampler R) L ξ <;> simp [hs, hn]
    rw [he]
    exact hS

theorem freshRows_indep_fullHistory (R : RootPair) (L : List (Site 2)) :
    Indep (freshRows L.length) (fullHistory R L) wilsonRows := by
  have hi : iIndep (rowSigma) wilsonRows :=
    iIndepFun_infinitePi (P := fun _ : ℕ => walkLaw) (X := fun _ (w : WalkDriver) => w)
      (fun _ => measurable_id)
  have hd : Disjoint {i : ℕ | L.length ≤ i} {i : ℕ | i < L.length} :=
    Set.disjoint_left.mpr (fun i hi hj => Nat.not_lt_of_ge hi hj)
  exact indep_of_indep_of_le_right (indep_iSup_of_disjoint rowSigma_le hi hd)
    (fullHistory_le_consumed R L)

theorem measurable_tail_fresh (n : ℕ) :
    @Measurable Rows Rows (freshRows n) inferInstance (fun ξ i => ξ (i + n)) := by
  letI : MeasurableSpace Rows := freshRows n
  apply measurable_pi_lambda
  intro i
  apply Measurable.of_comap_le
  exact le_iSup_of_le (i + n) (le_iSup_of_le (Nat.le_add_left n i) le_rfl)

theorem tail_map_wilsonRows (n : ℕ) :
    wilsonRows.map (fun ξ : Rows => fun i => ξ (i + n)) = wilsonRows :=
  Measure.map_infinitePi_infinitePi_of_inj (fun _ _ h => Nat.add_right_cancel h)

theorem measurable_continuationPattern (st : SamplerState) (Q : List (Site 2))
    (D : Finset (Site 2)) (pc : Site 2 → Bool) : MeasurableSet (continuationPattern st Q D pc) := by
  apply IsOpen.measurableSet
  apply isOpen_iff_mem_nhds.mpr
  rintro ξ ⟨next, hn, hp⟩
  filter_upwards [samplerRun_eventually_eq_of_some st next Q ξ hn] with η hη
  exact ⟨next, hη, hp⟩

/-- On a whole actual completed-history atom, the original batch continuation is
exactly the fresh tail exploration, including terminal hits and the full history. -/
theorem history_inter_continuation_eq (R : RootPair) (L Q : List (Site 2))
    (out : SamplerState) (D : Finset (Site 2)) (pc : Site 2 → Bool) :
    historyAtom R L out ∩ continuationPattern (initialSampler R) (L ++ Q) D pc =
      historyAtom R L out ∩
        (fun ξ : Rows => fun i => ξ (i + L.length)) ⁻¹' continuationPattern out Q D pc := by
  ext ξ
  constructor
  · rintro ⟨hh, next, hn, hp⟩
    change samplerRun (initialSampler R) L ξ = some out at hh
    refine ⟨hh, next, ?_, hp⟩
    simpa only [samplerRun_append, hh, Option.bind_some] using hn
  · rintro ⟨hh, next, hn, hp⟩
    change samplerRun (initialSampler R) L ξ = some out at hh
    refine ⟨hh, next, ?_, hp⟩
    simpa only [samplerRun_append, hh, Option.bind_some] using hn

/-- Conditional law on the exact full-history atom, without any contact estimate
or positive-mass conditioning assumption. -/
theorem conditional_continuation_color_law (R : RootPair) (L Q : List (Site 2))
    (ξ₀ : Rows) (out : SamplerState) (hs : samplerRun (initialSampler R) L ξ₀ = some out)
    (D : Finset (Site 2)) (pc : Site 2 → Bool) (hD : ∀ d ∈ D, d ∈ Q) :
    ∀ᵐ ξ ∂wilsonRows, ξ ∈ historyAtom R L out →
      (wilsonRows[(continuationPattern (initialSampler R) (L ++ Q) D pc).indicator
        (fun _ => (1 : ℝ)) | fullHistory R L]) ξ =
      (wilsonColorLaw (restartedRoots R L ξ₀ out hs)).real {σ | ∀ d ∈ D, σ d = pc d} := by
  let H := historyAtom R L out
  let S := continuationPattern (initialSampler R) (L ++ Q) D pc
  let E := (fun ξ : Rows => fun i => ξ (i + L.length)) ⁻¹' continuationPattern out Q D pc
  have hH : MeasurableSet[fullHistory R L] H := measurable_historyAtom R L out
  have hS : MeasurableSet S := measurable_continuationPattern _ _ _ _
  have hE : MeasurableSet[freshRows L.length] E :=
    (measurable_continuationPattern out Q D pc).preimage (measurable_tail_fresh L.length)
  have hE₀ : MeasurableSet E := freshRows_le L.length E hE
  have hcond := condExp_indep_eq (freshRows_le L.length) (fullHistory_le R L)
    (stronglyMeasurable_const.indicator hE : StronglyMeasurable[freshRows L.length]
      (E.indicator (fun _ => (1 : ℝ)))) (freshRows_indep_fullHistory R L)
  have hmass : (∫ ξ, E.indicator (fun _ => (1 : ℝ)) ξ ∂wilsonRows) =
      (wilsonColorLaw (restartedRoots R L ξ₀ out hs)).real {σ | ∀ d ∈ D, σ d = pc d} := by
    rw [integral_indicator hE₀, setIntegral_const, smul_eq_mul, mul_one]
    change (wilsonRows E).toReal = _
    rw [← Measure.map_apply (by fun_prop : Measurable (fun ξ : Rows => fun i => ξ (i + L.length)))
      (measurable_continuationPattern out Q D pc), tail_map_wilsonRows]
    exact congrArg ENNReal.toReal (fresh_continuation_color_pattern_law R L Q ξ₀ out hs D pc hD).symm
  have heq : H.indicator (S.indicator (fun _ => (1 : ℝ))) =
      H.indicator (E.indicator (fun _ => (1 : ℝ))) := by
    rw [Set.indicator_indicator, Set.indicator_indicator, history_inter_continuation_eq]
  have hc := condExp_congr_ae (μ := wilsonRows) (m := fullHistory R L) (Filter.Eventually.of_forall (congrFun heq))
  have hcs := condExp_indicator (μ := wilsonRows) (m := fullHistory R L) ((integrable_const (1 : ℝ)).indicator hS) hH
  have hce := condExp_indicator (μ := wilsonRows) (m := fullHistory R L) ((integrable_const (1 : ℝ)).indicator hE₀) hH
  filter_upwards [hc, hcs, hce, hcond] with ξ hc hcs hce hd hξ
  have hx : ξ ∈ H := hξ
  simp only [Set.indicator_of_mem hx] at hcs hce
  rw [hcs, hce, hd, hmass] at hc
  exact hc

                                                                          
                                                                                     
theorem history_success_mass_of_root_law_lower_bound (R : RootPair)
    (L Q : List (Site 2)) (ξ₀ : Rows) (out : SamplerState)
    (hs : samplerRun (initialSampler R) L ξ₀ = some out)
    (D : Finset (Site 2)) (pc : Site 2 → Bool) (hD : ∀ d ∈ D, d ∈ Q)
    (p : ℝ) (hbound : p ≤
      (wilsonColorLaw (restartedRoots R L ξ₀ out hs)).real {σ | ∀ d ∈ D, σ d = pc d}) :
    p * wilsonRows.real (historyAtom R L out) ≤
      ∫ ξ in historyAtom R L out,
        (continuationPattern (initialSampler R) (L ++ Q) D pc).indicator (fun _ => (1 : ℝ)) ξ
        ∂wilsonRows := by
  apply FiniteAvalanches.Probability.success_mass_ge_of_condExp wilsonRows
    (fullHistory R L) (fullHistory_le R L) _ _ (measurable_historyAtom R L out)
    (measurable_continuationPattern _ _ _ _) p
  filter_upwards [conditional_continuation_color_law R L Q ξ₀ out hs D pc hD] with ξ hξ hh
  rw [hξ hh]
  exact hbound

#print axioms measurable_full_output
#print axioms freshRows_indep_fullHistory
#print axioms tail_map_wilsonRows
#print axioms conditional_continuation_color_law
#print axioms history_success_mass_of_root_law_lower_bound
end
