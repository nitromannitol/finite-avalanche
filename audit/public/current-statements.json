    {
      "label": "fv:inverse-waves",
      "first_line": 293,
      "last_line": 295,
      "exact_statement": "\\begin{lemma}\\label{fv:inverse-waves}\nLet~$\\omega\\in X$. The wave from~$\\omega$ topples exactly the vertices of~$W(U\\omega)$, each once.\n\\end{lemma}",
