    {
      "label": "el:split-estimate",
      "first_line": 608,
      "last_line": 613,
      "exact_statement": "\\begin{lemma}\\label{el:split-estimate}\nFor every~$0<i<m$ and~$j\\in\\{i-1,i\\}$ we have\n\\begin{equation*}\n g_i-\\psi_i\\leq1+3888\\Bigl(1+\\log\\frac2{p_j}\\Bigr)\\,.\n\\end{equation*}\n\\end{lemma}",
