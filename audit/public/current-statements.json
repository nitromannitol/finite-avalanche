  "statements": [
    {
      "label": "th:main",
      "first_line": 50,
      "last_line": 55,
      "exact_statement": "\\begin{theorem}\\label{th:main}\nFor $\\mu$-almost every sandpile~$\\eta$, the sandpile~$\\eta+\\delta_0$ stabilizes. Moreover, there are constants~$a>0$ and~$C<\\infty$ such that every~$M\\geq0$ satisfies\n\\begin{equation*}\n\\mu(\\rho>M)\\leq C(\\log(M+2))^{-a}\\,.\n\\end{equation*}\n\\end{theorem}",
      "statement_sha256": "ac5b3e5ea7b7d40ad84843407a5bd13eee3dd1589a802960c8c727e1c151481d",
      "anchor": {
