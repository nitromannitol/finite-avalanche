    {
      "label": "ct:needle",
      "first_line": 450,
      "last_line": 452,
      "exact_statement": "\\begin{lemma}\\label{ct:needle}\nFor every integer~$h\\geq10$ and every~$w\\in\\partial[-2h,2h]^2$, there is a connected set~$Z\\subset [-2h,2h]^2$ that contains~$[-h,h]^2$ and~$w$ and for which the effective conductance between~$Z$ and~$\\Z^2\\setminus [-2h,2h]^2$ is at most~$107\\log h$.\n\\end{lemma}",
      "statement_sha256": "df087fa20108a4a9cec577bc8968cea052a26991a1fec32921912bcd83db9307",
      "anchor": {
        "path": "FiniteAvalanchesFrozen/Needle107V4.lean",
        "export": "FiniteAvalanchesFrozen.Needle107V4.connected_set_conductance_107",
        "sha256": "f60a8b5b073eb0b53169b697436a288ff90e5d723409d2871c5e10a0080213f3"
      },
      "statement_abi_sha256": "ca9cea3c2f17e0e8475e2d81550bb09bc3a9ed4d5adf0087f7cf6e5dfc552346",
      "source_relation": "EXPLICIT_BOX_WIRED_GRAPH_NOTATION_EQUIVALENCE_TO_C0; PROOF_AND_STANDING_MATHEMATICS_RETAINED",
      "proof_relation": "EXPLICIT_NOTATION_EQUIVALENT_PROOF_TO_C0"
