    {
      "label": "sp:reciprocal-reduction",
      "first_line": 248,
      "last_line": 253,
      "exact_statement": "\\begin{proposition}\\label{sp:reciprocal-reduction}\nThere is a universal constant~$C<\\infty$ such that all integers~$r\\geq2$ and~$M\\geq r+2$ satisfy\n\\begin{equation}\\label{sp:reduction-bound}\n\\mu(\\rho>M)\\leq\\limsup_{N\\to\\infty}\\EE\\bigl[\\cL_{T_N}^{-1}\\bigr]+Cr(M-r)^{-\\nf13}\\,.\n\\end{equation}\n\\end{proposition}",
      "statement_sha256": "357be90cfc68065b16e37f9c2f98be105129df99bc21af02a6e7f64d5cca3149",
      "anchor": {
        "path": "FiniteAvalanches/Paper/RevisionB972/FiniteLimsupStatement.lean",
        "export": "FiniteAvalanches.Paper.RevisionB972.reciprocal_reduction_limsup_v2",
        "sha256": "21b3c99ff6d102f97b331efc489eb897c98e41deb83da15262eb96a4b9d3a87c"
      },
      "statement_abi_sha256": "5e81885418511110904bdc30e547dc278aba3d7bff3c5d046f23726a9a6f161b",
      "source_relation": "BYTE_IDENTICAL_STATEMENT_TO_C0; PROOF_AND_STANDING_MATHEMATICS_RETAINED",
      "proof_relation": "EXPLICIT_NOTATION_EQUIVALENT_PROOF_TO_C0"
