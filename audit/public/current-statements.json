    {
      "label": "fo:local-comparison",
      "first_line": 386,
      "last_line": 391,
      "exact_statement": "\\begin{proposition}\\label{fo:local-comparison}\nThere is a universal constant~$\\varepsilon>0$ such that the following holds. Let~$r\\geq10^{30}$ be an integer, and let~$A$ and~$\\Gamma$ be disjoint sets of vertices of~$\\Z^2$ whose union has finite complement, such that~$0\\in A$ and~$\\Gamma$ contains a neighbor of~$0$. Assume that~$A$ is connected and meets~$\\Z^2\\setminus [-2r+1,2r-1]^2$, and that~$\\Gamma$ is connected and meets~$\\partial[-r,r]^2$. Then\n\\begin{equation*}\n\\nu_{A,\\Gamma}\\bigl(\\cL(A\\cap [-2r,2r]^2)\\geq\\tfrac18\\log r\\bigr)\\geq\\varepsilon\\,.\n\\end{equation*}\n\\end{proposition}",
      "statement_sha256": "3996d3cda277d097054957e3d2daa66ec8344ae3551af2f98f2cc001690da0e0",
      "anchor": {
        "path": "FiniteAvalanchesFrozen/JointCofiniteV4.lean",
        "export": "FiniteAvalanches.Wilson.Lattice.SourceTargets.local_comparison_and_revealed_roots_v4",
        "sha256": "e427242e699d5af6eee7bd98d1df5eed4cdb499abab91bb40587d73751375cd6"
      },
      "statement_abi_sha256": "a3df9350a7bd5ea609daa8a1c4ad69d49bb7e0e121a2d8a839200a8ec4262b9d",
      "source_relation": "EXPLICIT_BOX_WIRED_GRAPH_NOTATION_EQUIVALENCE_TO_C0; PROOF_AND_STANDING_MATHEMATICS_RETAINED",
      "proof_relation": "EXPLICIT_NOTATION_AND_RECORDED_PRESENTATION_EQUIVALENT_PROOF_TO_C0"
    },
    {
      "label": "el:reference-moment",
      "first_line": 395,
      "last_line": 400,
      "exact_statement": "\\begin{proposition}\\label{el:reference-moment}\nThere is a universal constant~$C<\\infty$ such that, for every network~$H_0$ as above, the mean~$\\EE Y$ is the energy of~$\\phi$ and\n\\begin{equation}\\label{el:reference-estimate}\n\\operatorname{Var}(Y)\\leq C\\,\\EE Y\\Bigl(1+\\log\\frac m{\\EE Y}\\Bigr)\\,.\n\\end{equation}\n\\end{proposition}",
      "statement_sha256": "05305036494ab5934d785b01f8409438819f50473477174787c39f59c8b3b0b6",
      "anchor": {
