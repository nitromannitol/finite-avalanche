        "sha256": "e427242e699d5af6eee7bd98d1df5eed4cdb499abab91bb40587d73751375cd6"
      },
      "statement_abi_sha256": "a3df9350a7bd5ea609daa8a1c4ad69d49bb7e0e121a2d8a839200a8ec4262b9d",
      "source_relation": "EXPLICIT_BOX_WIRED_GRAPH_NOTATION_EQUIVALENCE_TO_C0; PROOF_AND_STANDING_MATHEMATICS_RETAINED",
      "proof_relation": "EXPLICIT_NOTATION_AND_RECORDED_PRESENTATION_EQUIVALENT_PROOF_TO_C0"
    },
    {
      "label": "el:pair-contact",
      "first_line": 541,
      "last_line": 550,
      "exact_statement": "\\begin{lemma}\\label{el:pair-contact}\nFor every~$0\\leq i<j<m$ we have\n\\begin{align}\\label{el:pair-expanded}\n \\EE[I_iI_j]\n &=\\psi_i\\bigl(\\mathcal G(v_{i+1},v_j)-\\mathcal G(v_{i+1},v_{j+1})\\bigr)\n   -\\psi_{i+1}\\bigl(\\mathcal G(v_i,v_j)-\\mathcal G(v_i,v_{j+1})\\bigr)\\notag\\\\\n &\\quad-\\psi_j\\bigl(\\mathcal G(v_i,v_{j+1})-\\mathcal G(v_{i+1},v_{j+1})\\bigr)\n   +\\psi_{j+1}\\bigl(\\mathcal G(v_i,v_j)-\\mathcal G(v_{i+1},v_j)\\bigr)\\,.\n\\end{align}\n\\end{lemma}",
      "statement_sha256": "58a1b16d8042138e96d7b5488d974b9c5b31f33f22770bd4d1aa753fc0ebdf30",
      "anchor": {
