    {
      "label": "rd:past-tail",
      "first_line": 362,
      "last_line": 364,
      "exact_statement": "\\begin{lemma}\\label{rd:past-tail}\nThere is a universal constant~$C<\\infty$ such that~$\\PP\\bigl(\\operatorname{Past}_T(x)\\not\\subset [-M,M]^2\\bigr)\\leq C(M-r)^{-\\nf13}$ for every~$x\\in [-r,r]^2$.\n\\end{lemma}",
      "statement_sha256": "0d3fa546043395d4a61afc2acd107d188b73bb537c8bba73ca721ceaafa93e9c",
      "anchor": {
