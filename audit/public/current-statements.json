    {
      "label": "rd:conditional-law",
      "first_line": 257,
      "last_line": 259,
      "exact_statement": "\\begin{lemma}\\label{rd:conditional-law}\nLet~$N\\geq r$. On the event that the common ancestor of~$S$ in~$T_N$ is not~$s_N$, let~$\\Gamma_N$ be the union of~$\\Z^2\\setminus [-N,N]^2$ and the set of vertices of~$[-N,N]^2$ that follow the common ancestor on the path in~$T_N$ from the common ancestor to~$s_N$. Then, on this event, the set~$\\Gamma_N$ avoids~$K_{T_N}$, and the conditional law of~$\\cL_{T_N}$ given~$K_{T_N}$ and this path is the law of~$\\cL(K_{T_N})$ under~$\\nu_{K_{T_N},\\Gamma_N}$.\n\\end{lemma}",
      "statement_sha256": "1b10eed69289b6042586d121bfab823edb5710102767396252b6f898e12e0d80",
      "anchor": {
        "path": "FiniteAvalanches/Paper/Revision0F522C0/FiniteConditionalStatement.lean",
        "export": "FiniteAvalanches.Paper.Revision0F522C0.finite_conditional_contact_count_law",
        "sha256": "7671df58e51483c18b3ebe73ff38cca417c800977d9567ef447525cc89e3dda4"
      },
      "statement_abi_sha256": "7662f1c28b3a414cf45f5494a3d0ec3bcb5f48262000f3b57e8aaa961679f093",
