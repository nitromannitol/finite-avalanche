    },
    {
      "label": "el:arc-moment",
      "first_line": 574,
      "last_line": 579,
      "exact_statement": "\\begin{lemma}\\label{el:arc-moment}\nWe have\n\\begin{equation*}\n \\operatorname{Var}(Y)\\leq\\EE Y+3\\sum_{i=0}^{m-1}p_i\\bigl(g_i-\\psi_i+g_{i+1}-\\psi_{i+1}\\bigr)\\,.\n\\end{equation*}\n\\end{lemma}",
      "statement_sha256": "74c53b56a1e371e7b4808e5585eba9096fffa8fede46553f5ae4eb98e9134f8d",
