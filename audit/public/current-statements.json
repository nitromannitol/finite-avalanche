    {
      "label": "fv:outflow",
      "first_line": 336,
      "last_line": 341,
      "exact_statement": "\\begin{lemma}\\label{fv:outflow}\nWe have\n\\begin{equation*}\n \\bigl|\\{\\omega\\in X:S\\subset W(\\omega),\\ S\\not\\subset W(U\\omega)\\}\\bigr|\\leq\\tau([-N,N]^2)\\,\\EE\\bigl[\\cL_{T_N}^{-1}\\bigr]\\,.\n\\end{equation*}\n\\end{lemma}",
