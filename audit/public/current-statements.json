    {
      "label": "fo:lattice-monotonicity",
      "first_line": 207,
      "last_line": 209,
      "exact_statement": "\\begin{lemma}\\label{fo:lattice-monotonicity}\nLet~$A\\subset A'$ and~$\\Gamma'\\subset\\Gamma$ be subsets of~$\\Z^2$ for which~$\\nu_{A,\\Gamma}$ and~$\\nu_{A',\\Gamma'}$ are defined. Then the set of vertices of color one under~$\\nu_{A',\\Gamma'}$ is stochastically smaller than under~$\\nu_{A,\\Gamma}$.\n\\end{lemma}",
      "statement_sha256": "c4bf6ed22e88bc85d2df822cf39b21eb8e6ff430a2b4302cd16388b6581193ba",
      "anchor": {
        "path": "FiniteAvalanches/Paper/Revision480/LatticeColorMonotonicity.lean",
