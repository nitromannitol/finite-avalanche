    {
      "label": "fv:held-burning",
      "first_line": 181,
      "last_line": 183,
      "exact_statement": "\\begin{lemma}\\label{fv:held-burning}\nLet~$G$ be a finite connected loopless multigraph with a sink. Burn a uniform recurrent sandpile on~$G$ from the sink while holding a set of non-sink vertices unburned. Then the final unburned set has the law of the union of the pasts of the held vertices in a uniform spanning tree of~$G$ oriented toward the sink.\n\\end{lemma}",
      "statement_sha256": "11fe319e91289541ea3c025f1fd34baea57811968f4ebc2241a81614d34e6c36",
      "anchor": {
        "path": "FiniteAvalanches/Paper/SectionThree/HeldBurning.lean",
